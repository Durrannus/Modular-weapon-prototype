{
 "note": "Cracks, pine shake and fall, bursts. Sizes in px at 640x360, 1 art px = 1 screen px. See README.md.",
 "cracks": {
  "how": "Draw the picture over the tile's 16x16 (origin = the tile's top left), above the land and under the player. One set serves the dark top and the lit face. Mirror it left to right on every other tile for variety if you like.",
  "rock": [
   "crack_rock_1",
   "crack_rock_3"
  ],
  "tin": [
   "crack_tin_1",
   "crack_tin_2",
   "crack_tin_3"
  ],
  "copper": [
   "crack_copper_1",
   "crack_copper_2",
   "crack_copper_3"
  ],
  "rule": "rock takes 3 blows: after blow 1 and 2 show rock[0], rock[1]. Ore takes 4: after blow 1, 2, 3 show its three pictures. The last blow breaks it: play the burst."
 },
 "bursts": {
  "how": "A strip of frames side by side. Put the frame's origin on the middle of the tile (or on the point of the blow, for wood). Above the land and the things on it.",
  "ms_per_frame": 60,
  "rock": "burst_rock (a rock tile or a boulder breaks)",
  "tin": "burst_tin",
  "copper": "burst_copper",
  "wood": "burst_wood (each axe blow, and where the crown lands)"
 },
 "pines": {
  "how": "Every frame is drawn with its foot on the pine's foot. For a pine that stands mirrored, mirror the frame and its foot, and swap r and l.",
  "shake": "On a blow from the left: shake_r 50 ms, shake_l 60 ms, then the pine itself. From the right: shake_l first.",
  "fall": "On the last blow put the stump down at once, hide the pine, and play fall_r0..5 (it falls away from the player; _l to the left). The frames hold the tree above the cut only.",
  "fall_ms": [
   70,
   70,
   70,
   60,
   60,
   110
  ],
  "fall_deg": [
   5,
   14,
   28,
   47,
   68,
   88
  ],
  "then": "After the last frame the tree is gone: play burst_wood at its middle and drop the wood.",
  "shadow": "Fade the pine's shadow out over the fall."
 },
